{
  "name": "nimbo",
  "version": "3.1.1",
  "description": "Nimbo — your favorite sites, one key above the game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win nsis --x64",
    "build:unpacked": "electron-builder --win --x64 --dir",
    "build:signed": "electron-builder --win nsis --x64 --config.forceCodeSigning=true"
  },
  "author": "Dreamer",
  "license": "MIT",
  "homepage": "https://github.com/dreamersadobe/multioverlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/dreamersadobe/multioverlay.git"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "build": {
    "appId": "com.gameoverlay.app",
    "productName": "Nimbo",
    "publish": [
      {
        "provider": "github",
        "owner": "dreamersadobe",
        "repo": "multioverlay",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signingHashAlgorithms": [
        "sha256"
      ],
      "verifyUpdateCodeSignature": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": true,
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nimbo",
      "uninstallDisplayName": "Nimbo",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.css",
      "overlay.js",
      "overlay-utils.js",
      "app-profile.js",
      "app-updater.js",
      "i18n.js",
      "nimbo.css",
      "error.html",
      "config.json",
      "assets/**"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
